{
  "version": "1.0.0",
  "tools": [
    {
      "name": "generate_image",
      "description": "Generate or edit images. Covered models use the caller's subscription; other models spend tokens. Returns a durable job handle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64000,
            "description": "Complete user prompt; preserve all requested details."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Concrete model ID from list_models."
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "Additional native Sogni tool parameters. Preserved and validated by the API; do not duplicate named fields."
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://.+",
              "maxLength": 16384,
              "description": "HTTPS media download URL; never a local path or upload URL."
            },
            "maxItems": 16
          },
          "reference_audios": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://.+",
              "maxLength": 16384,
              "description": "HTTPS media download URL; never a local path or upload URL."
            },
            "maxItems": 16
          },
          "reference_videos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://.+",
              "maxLength": 16384,
              "description": "HTTPS media download URL; never a local path or upload URL."
            },
            "maxItems": 16
          },
          "token_type": {
            "type": "string",
            "enum": [
              "auto",
              "spark",
              "sogni"
            ],
            "description": "Payment currency. Auto follows account coverage."
          },
          "billing_mode": {
            "type": "string",
            "enum": [
              "auto",
              "subscription",
              "tokens"
            ],
            "description": "Billing preference passed to Sogni. Auto uses eligible subscription coverage; tokens opts into token billing. Premium models retain their normal charges."
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable unique request ID for this operation. Reuse it when retrying the same request; change it for new work.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer"
          },
          "mask": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://.+",
            "maxLength": 16384,
            "description": "HTTPS media download URL; never a local path or upload URL."
          },
          "safe_content_filter": {
            "type": "boolean",
            "description": "Use the user's chosen content-filter setting. Omit to retain the normal Sogni API default."
          }
        },
        "required": [
          "prompt",
          "model",
          "request_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "models",
              "account",
              "quote",
              "job",
              "upload"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "kind",
          "data"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
